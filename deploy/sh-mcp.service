# systemd unit for sh-mcp. All settings come from /etc/sh-mcp/env (mode 600).
# Every flag --x-y is the variable SH_MCP_X_Y; several values are separated
# by ";". See `sh-mcp --help` for all of them. For example:
#
#   SH_MCP_MODE=full
#   SH_MCP_ALLOW_DIR=/home/user/projects
#   SH_MCP_PUBLIC_URL=https://mcp.yourdomain.example
#   SH_MCP_AUTH_TOKEN=<output of: sh-mcp --gen-token>
#   SH_MCP_AUDIT_LOG=/var/log/sh-mcp/audit.jsonl
#
# For status checks only, use SH_MCP_MODE=ops with
# SH_MCP_ALLOW_COMMAND=df;free;journalctl instead.
#
# The token can also live in its own file: use LoadCredential= and
# SH_MCP_AUTH_TOKEN_FILE=%d/token instead of SH_MCP_AUTH_TOKEN.
#
# Keep ReadWritePaths in sync with SH_MCP_ALLOW_DIR and SH_MCP_AUDIT_LOG, then:
#   sudo cp sh-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sh-mcp

[Unit]
Description=sh-mcp MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sh-mcp
Group=sh-mcp
EnvironmentFile=/etc/sh-mcp/env
ExecStart=/usr/local/bin/sh-mcp
ExecReload=/bin/kill -HUP $MAINPID
WorkingDirectory=/home/user/projects
Restart=on-failure
RestartSec=5

# Sandbox: limit what a compromised token holder can change to the allowed
# directories and the audit log.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user/projects /var/log/sh-mcp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
